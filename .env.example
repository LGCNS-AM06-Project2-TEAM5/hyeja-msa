# docker compose와 각 서비스가 읽는 환경변수 예시입니다.
# 이 파일을 복사해 .env를 만들고 값을 채웁니다. .env는 커밋하지 않습니다.

# MariaDB
DB_ROOT_PASSWORD=
DB_USERNAME=hyeja
DB_PASSWORD=

# Compose는 서비스별 DB 계정을 사용합니다. 모두 서로 다른 값으로 채우세요.
USER_DB_PASSWORD=
POLICY_DB_PASSWORD=
ENGAGEMENT_DB_PASSWORD=

# PC에서 Compose 기반 시설로 접근할 때 사용하는 포트
MARIADB_HOST_PORT=13306
REDIS_HOST_PORT=16379
KAFKA_HOST_PORT=19092
ZIPKIN_HOST_PORT=9411

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# Redis 프로세스/AOF 오버헤드를 위해 maxmemory는 컨테이너 상한보다 낮게 설정합니다.
REDIS_MEMORY_LIMIT=128M
REDIS_MAXMEMORY=96mb
REDIS_MAXMEMORY_POLICY=noeviction

# 로그인 토큰 서명 키 (32자 이상)
JWT_SECRET=
# Gateway -> engagement only. Use a separate random key, at least 32 UTF-8 bytes.
GATEWAY_ENGAGEMENT_SECRET=

# 외부 API
YOUTH_API_KEY=
OPEN_AI_KEY=
OPEN_AI_MODEL=gpt-4o-mini

# 메일 (Gmail 사용 시 MAIL_PASSWORD에는 계정 비밀번호가 아닌 앱 비밀번호 입력)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# engagement-service DLT 관리자 알림
ADMIN_ALERT_EMAIL=
ADMIN_DLT_THRESHOLD=3
ADMIN_DLT_RETRY_INTERVAL_MS=60000

# 관리자 계정
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Config Server가 읽는 설정 저장소
CONFIG_GIT_URI=https://github.com/LGCNS-AM06-Project2-TEAM5/hyeja-config
CONFIG_GIT_LABEL=main

# Config Server only: master key must differ from JWT keys and account passwords.
CONFIG_ENCRYPT_KEY=
# Separate application-scoped accounts. All passwords must differ (16+ chars, <=72 UTF-8 bytes).
CONFIG_GATEWAY_USERNAME=config-gateway
CONFIG_GATEWAY_PASSWORD=
CONFIG_USER_USERNAME=config-user
CONFIG_USER_PASSWORD=
CONFIG_POLICY_USERNAME=config-policy
CONFIG_POLICY_PASSWORD=
CONFIG_ENGAGEMENT_USERNAME=config-engagement
CONFIG_ENGAGEMENT_PASSWORD=
CONFIG_RECOMMENDATION_USERNAME=config-recommendation
CONFIG_RECOMMENDATION_PASSWORD=
CONFIG_ADMIN_USERNAME=config-admin
CONFIG_ADMIN_PASSWORD=
# Generate local CA, server certificate and truststore with docker/New-ConfigTls.ps1.
CONFIG_TLS_KEY_STORE_PASSWORD=
CONFIG_TLS_TRUST_STORE_PASSWORD=

# Observability: set APP_PROFILES=docker,debug for sanitized Feign and Security DEBUG logs.
APP_PROFILES=docker
MONITORING_PASSWORD=
PROMETHEUS_HOST_PORT=9090
# Grafana(http://localhost:3000). 보기 전용이라 로그인·비밀번호가 없습니다.
GRAFANA_HOST_PORT=3000
