# docker compose와 각 서비스가 읽는 환경변수 예시입니다.
# 이 파일을 복사해 .env를 만들고 값을 채웁니다. .env는 커밋하지 않습니다.

# MariaDB
DB_ROOT_PASSWORD=
DB_USERNAME=hyeja
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# 로그인 토큰 서명 키 (32자 이상)
JWT_SECRET=

# 외부 API
YOUTH_API_KEY=
OPEN_AI_KEY=
OPEN_AI_MODEL=

# 메일 (비워 두면 인증 코드를 서버 로그에 출력)
MAIL_USERNAME=
MAIL_PASSWORD=

# 관리자 계정
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Config Server가 읽는 설정 저장소
CONFIG_GIT_URI=https://github.com/LGCNS-AM06-Project2-TEAM5/hyeja-config
