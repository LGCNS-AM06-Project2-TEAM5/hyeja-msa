# docker compose와 각 서비스가 읽는 환경변수 예시입니다.
# 이 파일을 복사해 .env를 만들고 값을 채웁니다. .env는 커밋하지 않습니다.

# MariaDB
DB_ROOT_PASSWORD=
DB_USERNAME=hyeja
DB_PASSWORD=

# Compose는 서비스별 DB 계정을 사용합니다. 모두 서로 다른 값으로 채우세요.
USER_DB_PASSWORD=
POLICY_DB_PASSWORD=
ENGAGEMENT_DB_PASSWORD=

# PC에서 Compose 기반 시설로 접근할 때 사용하는 포트
MARIADB_HOST_PORT=13306
REDIS_HOST_PORT=16379
KAFKA_HOST_PORT=19092
ZIPKIN_HOST_PORT=9411

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# 로그인 토큰 서명 키 (32자 이상)
JWT_SECRET=

# 외부 API
YOUTH_API_KEY=
OPEN_AI_KEY=
OPEN_AI_MODEL=gpt-4o-mini

# 메일 (비워 두면 인증 코드를 서버 로그에 출력)
MAIL_USERNAME=
MAIL_PASSWORD=

# 관리자 계정
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Config Server가 읽는 설정 저장소
CONFIG_GIT_URI=https://github.com/LGCNS-AM06-Project2-TEAM5/hyeja-config
CONFIG_GIT_LABEL=main

# Config Server only: master key must differ from JWT keys and account passwords.
CONFIG_ENCRYPT_KEY=
# Clients use only the reader account. Passwords must differ, 16+ characters, <=72 UTF-8 bytes.
CONFIG_READER_USERNAME=config-reader
CONFIG_READER_PASSWORD=
CONFIG_ADMIN_USERNAME=config-admin
CONFIG_ADMIN_PASSWORD=
